# Keine echten Werte ins Git. Vercel-Umgebungsvariablen sicher konfigurieren.
SENSE_AND_STARS_HOSTED=1
SENSE_AND_STARS_DEMO=0
SENSE_AND_STARS_PUBLIC_ORIGIN=https://sense-and-stars.vercel.app
DATABASE_URL=
CRON_SECRET=
# Sense & Stars wird unter AGPL-3.0-only veröffentlicht (siehe LICENSE).
SENSE_AND_STARS_SWISS_LICENSE=agpl-3.0
# Zur tatsächlich bereitgestellten vollständigen Source-Revision gehörender Link
SENSE_AND_STARS_SOURCE_URL=
# Optionaler Versand von Passwort-Rücksetzlinks. Ohne vollständige Konfiguration
# bleibt die Wiederherstellung deaktiviert. Nur freigegebene Versandzugänge nutzen.
SENSE_AND_STARS_SMTP_HOST=
SENSE_AND_STARS_SMTP_PORT=465
SENSE_AND_STARS_SMTP_SECURITY=ssl
SENSE_AND_STARS_SMTP_USERNAME=
SENSE_AND_STARS_SMTP_PASSWORD=
SENSE_AND_STARS_MAIL_FROM=
# Nur für isolierte lokale Tests: http://127.0.0.1:<port>
# SENSE_AND_STARS_RECOVERY_LOCAL_ORIGIN=
