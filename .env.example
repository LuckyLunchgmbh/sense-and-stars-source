# Keine echten Werte ins Git. Vercel-Umgebungsvariablen sicher konfigurieren.
SOULFLOW_HOSTED=1
SOULFLOW_DEMO=0
SOULFLOW_PUBLIC_ORIGIN=https://soulflow-marina.vercel.app
DATABASE_URL=
